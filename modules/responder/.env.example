# WhatsApp mode: "dry-run" (default, logs what WOULD be sent, sends nothing) or "live".
# Live mode is never the default and must be opted into explicitly.
WHATSAPP_MODE=dry-run

# Transport for live mode: cloud-api (official Meta - production default),
# evolution (NahaLabs Growth infra), or operator (my-own-whatsapp engine, low volume only).
WHATSAPP_TRANSPORT=cloud-api

# --- Official WhatsApp Business Cloud API (recommended) ---
WA_CLOUD_TOKEN=                  # permanent/system-user token
WA_CLOUD_PHONE_NUMBER_ID=        # WABA phone_number_id to send from
WA_CLOUD_API_VERSION=v21.0
WA_CLOUD_TEMPLATE_NAME=          # approved template for FIRST contact (24h-window rule)
WA_CLOUD_TEMPLATE_LANG=en
WA_CLOUD_APP_SECRET=             # webhook HMAC (X-Hub-Signature-256)
WA_CLOUD_VERIFY_TOKEN=           # webhook GET handshake token (you choose this)

# --- Evolution API (NahaLabs Growth infrastructure) ---
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=         # shared secret configured as a custom webhook header

# --- NahaLabs WhatsApp Operator (my-own-whatsapp engine; dev/low-volume only) ---
OPERATOR_URL=https://your-operator.onrender.com
OPERATOR_API_KEY=
WA_ACCOUNT_ID=
APP_ID=leadmachine-property
TENANT_ID=

# Where the dry-run transcript is written
DRY_RUN_LOG=demo-out/messages.jsonl

# Agent identity used in outbound copy
AGENT_NAME=Your Name
AGENCY_NAME=Your Agency

# --- Phase 2 connections ---

# Google OAuth for Gmail intake + Calendar (one-time consent flow, see README).
# When absent, Gmail intake is disabled and the stub calendar is used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gmail intake (read-only; marking off by default)
GMAIL_QUERY=from:(property24.com OR privateproperty.co.za) is:unread
GMAIL_MARK_PROCESSED=false
GMAIL_PROCESSED_LABEL=LeadMachine/Processed
GMAIL_MAX_PER_POLL=10
POLL_INTERVAL_SECONDS=60

# Google Calendar provider
GCAL_CALENDAR_ID=primary
VIEWING_DURATION_MIN=30

# Durable state (Render Postgres; falls back to in-memory when absent)
DATABASE_URL=

# Operator webhook receiver (same WEBHOOK_SECRET as the Operator)
WEBHOOK_PORT=3100
WEBHOOK_SECRET=

# Agent handover notifications (dry-run logged for now)
AGENT_PHONE=
