FROM node:22-bookworm-slim AS assets
WORKDIR /assets
COPY theme/static_src/package*.json ./
RUN npm ci --ignore-scripts
COPY . /source
RUN cd /source/theme/static_src && ln -s /assets/node_modules node_modules && npm run build
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
COPY --from=assets /source/theme/static /app/theme/static
RUN REVUP_RECOVERY_SYNTHETIC=1 REVUP_RECOVERY_ORIGIN=https://synthetic.invalid DATABASE_URL=postgresql://synthetic@localhost/revup_journeys SECRET_KEY=synthetic-build-only DJANGO_SETTINGS_MODULE=tools.recovery_host.settings python manage.py collectstatic --noinput
CMD ["sh", "-c", "exec gunicorn tools.recovery_host.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 1 --threads 2"]
